page {
  background: #f4f5f7;
  color: #1b1f24;
}

.page {
  padding: 32rpx 28rpx 64rpx;
}

.hero {
  margin-bottom: 28rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 26rpx;
}

.badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3cd;
  color: #7a5b00;
  font-size: 22rpx;
}

.card {
  padding: 28rpx;
  border: 1rpx solid #d8dde5;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 40, 0.08);
}

.field + .field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
}

.picker,
.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d8dde5;
  border-radius: 14rpx;
  background: #f8f9fb;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
}

.primary {
  margin-top: 32rpx;
  background: #0b63ce;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary[disabled] {
  opacity: 0.65;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 48rpx 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.section-hint,
.summary-meta {
  color: #667085;
  font-size: 24rpx;
}

.state {
  padding: 24rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #667085;
  text-align: center;
}

.state.error {
  background: #fdecec;
  color: #a12a2a;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.summary {
  padding: 24rpx;
  border: 1rpx solid #d8dde5;
  border-radius: 18rpx;
  background: #ffffff;
}

.summary-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  text-transform: capitalize;
}

.summary-count {
  display: block;
  margin: 8rpx 0 4rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.summary-meta {
  display: block;
  margin-top: 4rpx;
}
